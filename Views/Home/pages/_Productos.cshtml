@{
    ViewData["Title"] = "Productos";
    ViewData["ActiveNav"] = "productos";
    Layout = "~/Views/Shared/_Topbar.cshtml";
}

<h1>Productos</h1>

<section class="hero">
    <div class="hero-text">
        <span class="eyebrow" id="heroDate">
            <i class="bi bi-calendar3"></i> Panel de Productos
        </span>
        <h1 class="hero-title">Gestión de <span class="accent">Productos</span></h1>
        <p class="hero-sub">
            Crea y administra productos con categorías y atributos.

            Actualmente hay <strong>activos productos activos</strong> en el sistema.
        </p>
    </div>
    <div class="hero-action">
        <button class="btn btn--primary" data-bs-toggle="modal" data-bs-target="#modalCrear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Nuevo producto
        </button>
    </div>
</section>