@model IEnumerable<Drogueria.Models.Producto>
@{
    ViewData["Title"] = "Productos";
    ViewData["ActiveNav"] = "productos";
    Layout = "~/Views/Shared/_Topbar.cshtml";

    var lista = Model ?? Enumerable.Empty<Drogueria.Models.Producto>();
    int totalActivos = lista.Count(p => p.Estado);
}

@* ================= ALERTAS TempData ================= *@
@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm mb-4" role="alert"
         style="background: var(--success-soft); color: var(--success); border-radius: 12px;">
        <i class="bi bi-check-circle-fill me-2"></i>
        <strong>¡Éxito!</strong> @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm mb-4" role="alert"
         style="background: var(--danger-soft); color: var(--danger); border-radius: 12px;">
        <i class="bi bi-exclamation-triangle-fill me-2"></i>
        <strong>Atención:</strong> @TempData["Error"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
    </div>
}

@* ================= SECCIÓN HERO ================= *@
<section class="hero">
    <div class="hero-text">
        <span class="eyebrow" id="heroDate">
            <i class="bi bi-calendar3 me-1"></i> Panel de Productos
        </span>
        <h1 class="hero-title">Gestión de <span class="accent">Productos</span></h1>
        <p class="hero-sub">
            Crea y administra el inventario de la droguería.
            Actualmente hay <strong>@totalActivos productos activos</strong> en el sistema.
        </p>
    </div>
    <div class="hero-action">
        <button class="btn btn--primary" data-bs-toggle="modal" data-bs-target="#modalCrear">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Nuevo producto
        </button>
    </div>
</section>

@* ================= TABLA PRINCIPAL ================= *@
<div class="card">
    <div class="card-head">
        <div class="card-title-wrap">
            <span class="eyebrow">Inventario</span>
            <h2 class="card-title">Listado de Productos Registrados</h2>
        </div>

        <div class="d-flex align-items-center gap-2 flex-wrap">
            <div class="ui-search">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="11" cy="11" r="8" />
                    <path d="m21 21-4.3-4.3" />
                </svg>
                <input type="text" id="filtroProductos" placeholder="Buscar por nombre o categoría..." autocomplete="off" />
            </div>
        </div>
    </div>

    <div class="table-scroll">
        <table class="table table-adminator" id="tablaProductos">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Estado</th>
                    <th style="text-align: right;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (lista.Any())
                {
                    @foreach (var p in lista)
                    {
                        <tr class="fila-producto">
                            <!-- Imagen + Nombre -->
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    @if (!string.IsNullOrEmpty(p.Imagen))
                                    {
                                        <img src="/@p.Imagen" alt="@p.Nombre"
                                             style="width:40px;height:40px;object-fit:cover;border-radius:8px;border:1px solid var(--border);" />
                                    }
                                    else
                                    {
                                        <div style="width:40px;height:40px;border-radius:8px;background:var(--surface-2);
                                                    display:flex;align-items:center;justify-content:center;
                                                    border:1px solid var(--border);">
                                            <i class="bi bi-box-seam" style="color:var(--t-muted);font-size:18px;"></i>
                                        </div>
                                    }
                                    <div>
                                        <div class="cell-name">@p.Nombre</div>
                                        @if (!string.IsNullOrEmpty(p.Descripcion))
                                        {
                                            <div class="cell-email" style="max-width:220px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                                                @p.Descripcion
                                            </div>
                                        }
                                    </div>
                                </div>
                            </td>

                            <!-- Categoría -->
                            <td>
                                <span class="tag t-info">
                                    <i class="bi bi-tags"></i> @(p.Categoria?.Nombre ?? "—")
                                </span>
                            </td>

                            <!-- Precio -->
                            <td>
                                <span class="cell-name">$@p.Precio.ToString("N2")</span>
                            </td>

                            <!-- Stock -->
                            <td>
                                @if (p.Stock <= 0)
                                {
                                    <span class="tag t-unavail">Sin stock</span>
                                }
                                else if (p.Stock <= 5)
                                {
                                    <span class="tag t-used">@p.Stock uds.</span>
                                }
                                else
                                {
                                    <span class="tag t-active">@p.Stock uds.</span>
                                }
                            </td>

                            <!-- Estado -->
                            <td>
                                @if (p.Estado)
                                {
                                    <span class="tag t-active"><span class="tag-dot"></span> Activo</span>
                                }
                                else
                                {
                                    <span class="tag t-unavail"><span class="tag-dot"></span> Inactivo</span>
                                }
                            </td>

                            <!-- Acciones -->
                            <td style="text-align: right;">
                                <div class="d-inline-flex align-items-center gap-1">
                                    <!-- Editar -->
                                    <button class="btn-action-icon edit"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditar"
                                            data-id="@p.Id"
                                            data-nombre="@p.Nombre"
                                            data-descripcion="@(p.Descripcion ?? "")"
                                            data-precio="@p.Precio.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                            data-categoria-id="@p.CategoriaId"
                                            data-stock="@p.Stock"
                                            data-estado="@p.Estado.ToString().ToLowerInvariant()"
                                            data-fecha="@p.FechaCreacion.ToString("o")"
                                            data-imagen="@(p.Imagen ?? "")"
                                            title="Editar">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>

                                    <!-- Desactivar -->
                                    <form method="post" asp-controller="Producto" asp-action="Delete" asp-route-id="@p.Id"
                                          class="d-inline desactivar-form" data-producto-id="@p.Id">
                                        @Html.AntiForgeryToken()
                                        <button type="button" class="btn-action-icon danger"
                                                data-bs-toggle="modal"
                                                data-bs-target="#glassConfirmModal"
                                                data-id="@p.Id"
                                                data-nombre="@p.Nombre"
                                                title="Desactivar">
                                            <i class="bi bi-person-x-fill"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="d-flex flex-column align-items-center justify-content-center text-muted">
                                <i class="bi bi-box-seam" style="font-size: 42px; opacity: 0.4; margin-bottom: 12px;"></i>
                                <span class="fw-semibold">No se encontraron productos en la base de datos</span>
                                <small class="text-muted mb-3">Comienza agregando el primer producto de tu droguería.</small>
                                <button class="btn btn--primary" data-bs-toggle="modal" data-bs-target="#modalCrear">
                                    <i class="bi bi-plus-lg me-1"></i> Registrar Primer Producto
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* ── Modal Crear ─────────────────────────────────────────── *@
<div class="modal fade" id="modalCrear" tabindex="-1" aria-labelledby="modalCrearLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-glass">
            <div class="modal-header">
                <div>
                    <span class="eyebrow" style="font-size: 10px;">Nuevo Registro</span>
                    <h5 class="modal-title" id="modalCrearLabel">Crear Nuevo Producto</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form method="post" asp-controller="Producto" asp-action="Create" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Nombre -->
                        <div class="col-sm-8">
                            <label class="form-label" for="crearNombre">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="crearNombre" name="Nombre"
                                   placeholder="Ej. Ibuprofeno 400mg" required maxlength="150" />
                        </div>

                        <!-- Categoría -->
                        <div class="col-sm-4">
                            <label class="form-label" for="crearCategoria">Categoría <span class="text-danger">*</span></label>
                            <select class="form-select" id="crearCategoria" name="CategoriaId" required>
                                <option value="">— Seleccionar —</option>
                                @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.Categorias)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>

                        <!-- Descripción -->
                        <div class="col-12">
                            <label class="form-label" for="crearDescripcion">Descripción</label>
                            <textarea class="form-control" id="crearDescripcion" name="Descripcion"
                                      placeholder="Descripción breve del producto..." rows="2" maxlength="500"></textarea>
                        </div>

                        <!-- Precio -->
                        <div class="col-sm-4">
                            <label class="form-label" for="crearPrecio">Precio <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="crearPrecio" name="Precio"
                                       placeholder="0.00" min="0" step="0.01" required />
                            </div>
                        </div>

                        <!-- Stock -->
                        <div class="col-sm-4">
                            <label class="form-label" for="crearStock">Stock</label>
                            <input type="number" class="form-control" id="crearStock" name="Stock"
                                   placeholder="0" min="0" value="0" />
                        </div>

                        <!-- Imagen -->
                        <div class="col-sm-4">
                            <label class="form-label" for="crearImagen">Imagen</label>
                            <input type="file" class="form-control" id="crearImagen" name="imagenFile"
                                   accept=".jpg,.jpeg,.png,.webp,.gif" />
                            <small class="text-muted">JPG, PNG, WEBP (opcional)</small>
                        </div>

                        <!-- Estado -->
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="crearEstado" name="Estado" value="true" checked />
                                <label class="form-check-label small fw-semibold" for="crearEstado" style="color: var(--t-base);">
                                    Producto Activo (visible en el sistema)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn--ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn--primary">
                        <i class="bi bi-box-seam me-1"></i> Guardar Producto
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Modal Editar ────────────────────────────────────────── *@
<div class="modal fade" id="modalEditar" tabindex="-1" aria-labelledby="modalEditarLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-glass">
            <div class="modal-header">
                <div>
                    <span class="eyebrow" style="font-size: 10px;">Editar Registro</span>
                    <h5 class="modal-title" id="modalEditarLabel">Editar Producto</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <form method="post" asp-controller="Producto" asp-action="Edit" id="formEditar" enctype="multipart/form-data">
                @Html.AntiForgeryToken()
                <input type="hidden" id="editarId" name="Id" />
                <input type="hidden" id="editarFecha" name="FechaCreacion" />
                <input type="hidden" id="editarImagenActual" name="Imagen" />

                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Nombre -->
                        <div class="col-sm-8">
                            <label class="form-label" for="editarNombre">Nombre <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="editarNombre" name="Nombre"
                                   placeholder="Ej. Ibuprofeno 400mg" required maxlength="150" />
                        </div>

                        <!-- Categoría -->
                        <div class="col-sm-4">
                            <label class="form-label" for="editarCategoria">Categoría <span class="text-danger">*</span></label>
                            <select class="form-select" id="editarCategoria" name="CategoriaId" required>
                                <option value="">— Seleccionar —</option>
                                @foreach (SelectListItem item in (IEnumerable<SelectListItem>)ViewBag.Categorias)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>

                        <!-- Descripción -->
                        <div class="col-12">
                            <label class="form-label" for="editarDescripcion">Descripción</label>
                            <textarea class="form-control" id="editarDescripcion" name="Descripcion"
                                      placeholder="Descripción breve del producto..." rows="2" maxlength="500"></textarea>
                        </div>

                        <!-- Precio -->
                        <div class="col-sm-4">
                            <label class="form-label" for="editarPrecio">Precio <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="number" class="form-control" id="editarPrecio" name="Precio"
                                       placeholder="0.00" min="0" step="0.01" required />
                            </div>
                        </div>

                        <!-- Stock -->
                        <div class="col-sm-4">
                            <label class="form-label" for="editarStock">Stock</label>
                            <input type="number" class="form-control" id="editarStock" name="Stock"
                                   placeholder="0" min="0" />
                        </div>

                        <!-- Imagen -->
                        <div class="col-sm-4">
                            <label class="form-label">Imagen actual</label>
                            <div id="editarImagenPreview" class="mb-2"></div>
                            <input type="file" class="form-control" id="editarImagenFile" name="imagenFile"
                                   accept=".jpg,.jpeg,.png,.webp,.gif" />
                            <small class="text-muted">Dejar vacío para conservar la imagen actual</small>
                        </div>

                        <!-- Estado -->
                        <div class="col-12">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="editarEstado" name="Estado" value="true" />
                                <label class="form-check-label small fw-semibold" for="editarEstado" style="color: var(--t-base);">
                                    Producto Activo (visible en el sistema)
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn--ghost" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn--primary">
                        <i class="bi bi-pencil-fill me-1"></i> Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@* ── Modal Confirmar Desactivar ──────────────────────────── *@
<div class="modal fade" id="glassConfirmModal" tabindex="-1" aria-labelledby="glassConfirmLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content modal-glass">
            <div class="modal-header">
                <h5 class="modal-title" id="glassConfirmLabel">¿Desactivar producto?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p style="color: var(--t-muted); font-size: 13px; margin: 0;" id="glassConfirmTexto">
                    Esta acción desactivará el producto seleccionado. Podrás reactivarlo cuando quieras desde el listado.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn--ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" id="btnConfirmarDesactivar" class="btn btn--ghost"
                        style="color: var(--danger); border-color: var(--danger);"
                        onclick="confirmarDesactivarProducto()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6" />
                    </svg>
                    Desactivar
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/js/landingPages.js" asp-append-version="true"></script>

@section Scripts {
    <script>
    let idProductoADesactivar = null;

    function confirmarDesactivarProducto() {
        if (!idProductoADesactivar) return;
        const form = document.querySelector(`.desactivar-form[data-producto-id="${idProductoADesactivar}"]`);
        if (form) form.submit();
    }

    function cargarFecha() {
        const fechaEl = document.getElementById("heroDate");
        if (!fechaEl) return;
        const hoy = new Date();
        const opciones = { day: "numeric", month: "long", year: "numeric" };
        fechaEl.innerHTML = `<i class="bi bi-calendar3 me-1"></i> ` + hoy.toLocaleDateString("es-ES", opciones);
    }

    function autoOcultarAlertas() {
        document.querySelectorAll(".alert-dismissible").forEach(function (alertEl) {
            setTimeout(function () {
                const instancia = bootstrap.Alert.getOrCreateInstance(alertEl);
                instancia.close();
            }, 4000);
        });
    }

    document.addEventListener("DOMContentLoaded", function () {
        cargarFecha();
        autoOcultarAlertas();

        // Filtro en tiempo real
        document.getElementById("filtroProductos")?.addEventListener("input", function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll(".fila-producto").forEach(function (fila) {
                const texto = fila.textContent.toLowerCase();
                fila.style.display = texto.includes(q) ? "" : "none";
            });
        });

        // Modal Editar — carga datos desde data-attributes
        const editModal = document.getElementById("modalEditar");
        if (editModal) {
            editModal.addEventListener("show.bs.modal", function (event) {
                const btn = event.relatedTarget;
                if (!btn) return;

                const id          = btn.getAttribute("data-id");
                const nombre      = btn.getAttribute("data-nombre");
                const desc        = btn.getAttribute("data-descripcion");
                const precio      = btn.getAttribute("data-precio");
                const categoriaId = btn.getAttribute("data-categoria-id");
                const stock       = btn.getAttribute("data-stock");
                const estado      = btn.getAttribute("data-estado");
                const fecha       = btn.getAttribute("data-fecha");
                const imagen      = btn.getAttribute("data-imagen");

                document.getElementById("editarId").value       = id || "";
                document.getElementById("editarNombre").value   = nombre || "";
                document.getElementById("editarDescripcion").value = desc || "";
                document.getElementById("editarPrecio").value   = precio || "";
                document.getElementById("editarStock").value    = stock || "0";
                document.getElementById("editarEstado").checked = estado === "true";
                document.getElementById("editarFecha").value    = fecha || "";
                document.getElementById("editarImagenActual").value = imagen || "";
                document.getElementById("formEditar").action    = `/Producto/Edit/${id}`;

                // Seleccionar categoría
                const selectCat = document.getElementById("editarCategoria");
                if (selectCat) selectCat.value = categoriaId || "";

                // Preview imagen actual
                const preview = document.getElementById("editarImagenPreview");
                if (preview) {
                    preview.innerHTML = imagen
                        ? `<img src="/${imagen}" alt="Imagen actual"
                               style="width:60px;height:60px;object-fit:cover;border-radius:8px;border:1px solid var(--border);" />`
                        : `<span style="color:var(--t-muted);font-size:12px;">Sin imagen</span>`;
                }
            });
        }

        // Modal Confirmar Desactivar
        const confirmModal = document.getElementById("glassConfirmModal");
        if (confirmModal) {
            confirmModal.addEventListener("show.bs.modal", function (event) {
                const btn = event.relatedTarget;
                idProductoADesactivar = btn?.getAttribute("data-id") || null;
                const nombre = btn?.getAttribute("data-nombre") || "este producto";

                const texto = document.getElementById("glassConfirmTexto");
                if (texto) {
                    texto.textContent = `Esta acción desactivará el producto "${nombre}". Podrás reactivarlo cuando quieras desde el listado.`;
                }
            });
        }
    });
    </script>
}