@{
ViewData["Title"] = "Nosotros";
ViewData["ActiveNav"] = "nosotros";
Layout = "/Views/Shared/_LayoutPublico.cshtml";
}

<link rel="stylesheet" href="~/css/layout-Nosotros.css" asp-append-version="true" />

<div class="pagina-nosotros" >

    <div class="nosotros-botones">

    <a asp-controller="Home"
    asp-action="Index"
    class="btn btn-light border shadow-sm d-inline-flex align-items-center gap-2 boton-volver"> <i class="bi bi-arrow-left"></i>
    Volver al inicio </a>



    </div>

<section class="informacion">

    <div class="informacion-contenido">

        <div class="informacion-texto">

            <span class="etiqueta">
                CONÓCENOS
            </span>

            <h2>
                ¿Quiénes somos?
            </h2>

            <p>
                Somos una droguería comprometida con ofrecer productos
                de calidad y brindar una excelente atención a nuestros clientes.
            </p>

            <p>
                Nuestro objetivo es ayudarte a cuidar tu salud y la de tu
                familia, ofreciéndote productos confiables y una atención cercana.
            </p>

            <p>
                Trabajamos cada día para brindar un servicio rápido, seguro
                y pensado en las necesidades de nuestros clientes.
            </p>

        </div>

        <div class="informacion-beneficios">

            <div class="beneficio">
                <span>💜</span>

                <div>
                    <h3>Calidad</h3>
                    <p>
                        Ofrecemos productos seleccionados y confiables.
                    </p>
                </div>
            </div>

            <div class="beneficio">
                <span>👨‍⚕️</span>

                <div>
                    <h3>Atención personalizada</h3>
                    <p>
                        Estamos disponibles para ayudarte y orientarte.
                    </p>
                </div>
            </div>

            <div class="beneficio">
                <span>🤝</span>

                <div>
                    <h3>Confianza</h3>
                    <p>
                        Tu bienestar es una de nuestras principales prioridades.
                    </p>
                </div>
            </div>

        </div>

    </div>

</section>

<section class="porque-elegir">

    <span class="etiqueta">
        NUESTRO COMPROMISO
    </span>

    <h2>
        ¿Por qué elegirnos?
    </h2>

    <div class="ventajas">

        <div class="ventaja">
            <span>⚡</span>
            <h3>Atención rápida</h3>
            <p>
                Te atendemos de manera ágil y eficiente.
            </p>
        </div>

        <div class="ventaja">
            <span>💜</span>
            <h3>Productos de calidad</h3>
            <p>
                Trabajamos para ofrecer productos confiables.
            </p>
        </div>

        <div class="ventaja">
            <span>🏠</span>
            <h3>Comodidad</h3>
            <p>
                Facilitamos el acceso a nuestros productos.
            </p>
        </div>

        <div class="ventaja">
            <span>🤝</span>
            <h3>Confianza</h3>
            <p>
                Tu salud y bienestar son nuestra prioridad.
            </p>
        </div>

    </div>
    

</section>

</div>
