    </div>
</div>

@section Scripts {
    <script src="~/js/landingPages.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Auto-cerrar alertas dismissibles
            document.querySelectorAll(".alert-dismissible").forEach(function (alertEl) {
                setTimeout(function () {
                    const instancia = bootstrap.Alert.getOrCreateInstance(alertEl);
                    instancia.close();
                }, 4000);
            });

            // Si el servidor indicó abrir algún modal en recarga (fallback)
            @if (TempData["AbrirModal"] != null)
            {
                <text>
                const modalId = "@TempData["AbrirModal"]";
                const modalEl = document.getElementById(modalId);
                if (modalEl) {
                    const modalInst = bootstrap.Modal.getOrCreateInstance(modalEl);
                    modalInst.show();
                }
                </text>
            }

            // AJAX login para validar credenciales sin recargar la página ni enviar a otra ubicación
            document.querySelectorAll(".modal-login-form").forEach(function (form) {
                form.addEventListener("submit", async function (e) {
                    e.preventDefault();

                    const submitBtn = form.querySelector("button[type='submit']");
                    const originalHtml = submitBtn.innerHTML;
                    const bodyEl = form.closest(".modal-login-body");
                    const alertContainer = bodyEl ? bodyEl.querySelector(".modal-login-alert-container") : null;

                    // Limpiar alertas previas dentro del modal
                    if (alertContainer) alertContainer.innerHTML = "";

                    // Estado de carga en el botón
                    submitBtn.disabled = true;
                    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span><span>Verificando...</span>';

                    try {
                        const formData = new FormData(form);
                        const response = await fetch(form.action, {
                            method: "POST",
                            body: formData,
                            headers: {
                                "X-Requested-With": "XMLHttpRequest",
                                "Accept": "application/json"
                            }
                        });

                        const data = await response.json();

                        if (data.success) {
                            // Login exitoso: redirigir a su destino (Tienda o Panel)
                            if (data.redirectUrl) {
                                window.location.href = data.redirectUrl;
                                return;
                            }
                            // Registro exitoso: abrir modal de login
                            if (data.openModal) {
                                const currentModalEl = form.closest(".modal");
                                if (currentModalEl) {
                                    bootstrap.Modal.getInstance(currentModalEl)?.hide();
                                }
                                const targetModalEl = document.getElementById(data.openModal);
                                if (targetModalEl) {
                                    const targetAlert = targetModalEl.querySelector(".modal-login-alert-container");
                                    if (targetAlert && data.message) {
                                        targetAlert.innerHTML = `
                                            <div class="alert alert-success d-flex align-items-center gap-2 mb-3 py-2 px-3 small rounded-3" role="alert">
                                                <i class="bi bi-check-circle-fill text-success fs-6 flex-shrink-0"></i>
                                                <div>${data.message}</div>
                                            </div>`;
                                    }
                                    bootstrap.Modal.getOrCreateInstance(targetModalEl).show();
                                }
                                submitBtn.disabled = false;
                                submitBtn.innerHTML = originalHtml;
                                return;
                            }
                        } else {
                            // Error de credenciales: NO ENVIAR A OTRA UBICACIÓN
                            // Mostrar mensaje de error dentro del modal
                            if (alertContainer) {
                                alertContainer.innerHTML = `
                                    <div class="alert alert-danger d-flex align-items-center gap-2 mb-3 py-2 px-3 small rounded-3" role="alert">
                                        <i class="bi bi-exclamation-triangle-fill text-danger fs-6 flex-shrink-0"></i>
                                        <div>${data.message || "Por favor, valide si el usuario o la contraseña son correctos."}</div>
                                    </div>`;
                            }

                            // Limpiar y enfocar el campo de contraseña
                            const passInput = form.querySelector("input[type='password']");
                            if (passInput) {
                                passInput.value = "";
                                passInput.focus();
                            }
                        }
                    } catch (err) {
                        // En caso de error de red o no soportado, fallback a POST tradicional
                        form.submit();
                        return;
                    } finally {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = originalHtml;
                    }
                });
            });
        });
    </script>
}