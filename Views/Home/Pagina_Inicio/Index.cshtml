<!-- CARRUSEL SCRIPT -->
<script>
    let pastillaActual = 0;

    function mostrarPastilla(indice) {
        const slides = document.querySelectorAll(".pastilla-slide");
        const puntos = document.querySelectorAll(".punto-pastilla");

        if (slides.length === 0) return;

        if (indice >= slides.length) {
            pastillaActual = 0;
        } else if (indice < 0) {
            pastillaActual = slides.length - 1;
        } else {
            pastillaActual = indice;
        }

        slides.forEach(function (slide) {
            slide.classList.remove("activo");
        });

        puntos.forEach(function (punto) {
            punto.classList.remove("activo");
        });

        slides[pastillaActual].classList.add("activo");
        if (puntos[pastillaActual]) {
            puntos[pastillaActual].classList.add("activo");
        }
    }

    function cambiarPastilla(direccion) {
        mostrarPastilla(pastillaActual + direccion);
    }

    function irPastilla(indice) {
        mostrarPastilla(indice);
    }
</script>

<!-- Modal Empleado -->
<div class="modal fade modal-login" id="_LoginEmpleado" tabindex="-1" aria-labelledby="_LoginEmpleadoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-login-banner">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                <div class="modal-login-icon-box">
                    <i class="bi bi-person-badge"></i>
                </div>
                <h4 class="modal-login-title" id="_LoginEmpleadoLabel">Acceso Empleados</h4>
                <p class="modal-login-subtitle">Gestión de inventarios, pedidos y punto de venta</p>
            </div>
            <div class="modal-login-body">
                <form class="modal-login-form" method="post" asp-controller="Account" asp-action="Login">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="rolEsperado" value="Empleado" />
                    <div class="mb-3">
                        <label for="emp-user" class="form-label">Usuario o Correo</label>
                        <div class="input-group-custom">
                            <i class="bi bi-person input-icon"></i>
                            <input type="text" class="form-control" id="emp-user" name="email" placeholder="ej. empleado@drogueria.com" required autocomplete="username">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="emp-pass" class="form-label">Contraseña</label>
                        <div class="input-group-custom">
                            <i class="bi bi-lock input-icon"></i>
                            <input type="password" class="form-control" id="emp-pass" name="password" placeholder="••••••••" required autocomplete="current-password">
                            <button type="button" class="btn-toggle-password" onclick="togglePasswordVisibility('emp-pass', this)" title="Ver contraseña">
                                <i class="bi bi-eye"></i>
                            </button>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="rememberEmp">
                            <label class="form-check-label small text-muted" for="rememberEmp">Recordar sesión</label>
                        </div>
                        <a href="#" class="text-decoration-none small fw-semibold text-primary">¿Olvidaste tu clave?</a>
                    </div>
                    <button type="submit" class="btn btn-login-submit">
                        <span>Iniciar Sesión</span>
                        <i class="bi bi-arrow-right-short fs-4"></i>
                    </button>
                </form>
            </div>
            <div class="modal-login-footer">
                <i class="bi bi-lock-fill me-1 text-primary"></i> Área restringida únicamente a personal autorizado
            </div>
        </div>
    </div>
</div>

