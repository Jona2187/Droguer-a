    <!-- VITRINA DE PRODUCTOS REALES -->
    <section class="carrusel-pastillas" id="productos" style="padding: 80px 20px;">
        <span class="etiqueta">NUESTROS PRODUCTOS</span>
        <h2>Medicamentos y productos de salud</h2>
        <p class="texto-seccion">Encuentra lo que necesitas para cuidar tu salud.</p>

        @{
            var productosVitrina = ViewBag.ProductosVitrina as List<Drogueria.Models.Producto> ?? new List<Drogueria.Models.Producto>();
        }

        @if (productosVitrina.Count == 0)
        {
            <div style="text-align:center; padding: 48px; opacity:.6;">
                <p>Próximamente encontrarás aquí nuestro catálogo completo.</p>
            </div>
        }
        else
        {
            <!-- Grid de tarjetas de productos -->
            <div style="display:grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; max-width: 1200px; margin: 48px auto 0;">
                @foreach (var prod in productosVitrina)
                {
                    var imgSrc = !string.IsNullOrEmpty(prod.Imagen)
                        ? "/" + prod.Imagen
                        : "/img/pastilla1.jpeg";
                    var categoria = prod.Categoria?.Nombre ?? "Medicamento";

                    <div class="pub-prod-card">
                        <div class="pub-prod-img-wrap">
                            <img src="@imgSrc" alt="@prod.Nombre" class="pub-prod-img" onerror="this.src='/img/pastilla1.jpeg'" />
                            <span class="pub-prod-cat-badge">@categoria</span>
                        </div>
                        <div class="pub-prod-body">
                            <h3 class="pub-prod-name">@prod.Nombre</h3>
                            @if (!string.IsNullOrWhiteSpace(prod.Descripcion))
                            {
                                <p class="pub-prod-desc">@(prod.Descripcion!.Length > 70 ? prod.Descripcion.Substring(0, 70) + "…" : prod.Descripcion)</p>
                            }
                            <div class="pub-prod-footer">
                                <span class="pub-prod-price">$@prod.Precio.ToString("N2")</span>
                                <div class="pub-prod-actions">
                                    <a href="/" class="pub-btn-cart" data-bs-toggle="modal" data-bs-target="#_LoginCliente" title="Inicia sesión para agregar al carrito">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
                                    </a>
                                    <a href="/" class="pub-btn-buy" data-bs-toggle="modal" data-bs-target="#_LoginCliente">Comprar</a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

