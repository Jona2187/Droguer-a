@section Scripts {
    <script>
        const NUMERO_WHATSAPP = "573135958228";
        let rolSeleccionado = "empleado";

        function cambiarRol(rol) {
            rolSeleccionado = rol;
            const tabEmp = document.getElementById("tabRolEmpleado");
            const tabRep = document.getElementById("tabRolRepartidor");
            const formEmp = document.getElementById("formEmpleado");
            const formRep = document.getElementById("formRepartidor");

            if (rol === "empleado") {
                tabEmp.classList.add("activo");
                tabEmp.setAttribute("aria-selected", "true");
                tabRep.classList.remove("activo");
                tabRep.setAttribute("aria-selected", "false");

                formEmp.style.display = "block";
                formRep.style.display = "none";
            } else {
                tabRep.classList.add("activo");
                tabRep.setAttribute("aria-selected", "true");
                tabEmp.classList.remove("activo");
                tabEmp.setAttribute("aria-selected", "false");

                formRep.style.display = "block";
                formEmp.style.display = "none";
            }
        }

        function cambiarTipoVehiculo(tipo) {
            const campoLic = document.getElementById("campoLicencia");
            const campoPapeles = document.getElementById("campoPapeles");
            if (tipo.includes("Bicicleta")) {
                if (campoLic) {
                    document.getElementById("repLicencia").value = "No aplica (Bicicleta)";
                }
                const radioNo = document.getElementById("papelesNo");
                if (radioNo) radioNo.checked = true;
            } else if (tipo.includes("Motocicleta")) {
                if (campoLic) {
                    document.getElementById("repLicencia").value = "A2 (Motos de cualquier cilindraje)";
                }
                const radioSi = document.getElementById("papelesSi");
                if (radioSi) radioSi.checked = true;
            }
        }

        function actualizarContador(textarea, targetId) {
            const contador = document.getElementById(targetId);
            if (contador) {
                const len = textarea.value.length;
                contador.textContent = `${len} / ${textarea.maxLength} caracteres`;
            }
        }

        function procesarArchivo(input, previewId, nombreId) {
            const file = input.files[0];
            if (file) {
                if (file.size > 5 * 1024 * 1024) {
                    alert("El archivo supera el límite de 5MB. Por favor selecciona un documento más liviano o comparte un enlace.");
                    input.value = "";
                    return;
                }
                const preview = document.getElementById(previewId);
                const nombreEl = document.getElementById(nombreId);
                if (preview && nombreEl) {
                    nombreEl.textContent = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;
                    preview.style.display = "flex";
                }
            }
        }

        function quitarArchivo(inputId, previewId) {
            const input = document.getElementById(inputId);
            const preview = document.getElementById(previewId);
            if (input) input.value = "";
            if (preview) preview.style.display = "none";
        }

        function construirMensajeWhatsApp(rol) {
            const form = rol === "empleado" ? document.getElementById("formEmpleado") : document.getElementById("formRepartidor");
            const data = new FormData(form);

            const nombre = (data.get("Nombre") || "").toString().trim();
            const apellido = (data.get("Apellido") || "").toString().trim();
            const tipoDoc = (data.get("TipoDocumento") || "").toString().trim();
            const numDoc = (data.get("NumeroDocumento") || "").toString().trim();
            const tel = (data.get("Telefono") || "").toString().trim();
            const correo = (data.get("Correo") || "").toString().trim();
            const ciudad = (data.get("Ciudad") || "").toString().trim();
            const barrio = (data.get("Barrio") || "").toString().trim();
            const enlaceCv = (data.get("EnlaceCv") || "").toString().trim();
            const fileInput = form.querySelector('input[type="file"]');
            const tieneArchivo = fileInput && fileInput.files && fileInput.files.length > 0;
            const nombreArchivo = tieneArchivo ? fileInput.files[0].name : null;

            let lineas = [];

            if (rol === "empleado") {
                const cargo = (data.get("Cargo") || "Auxiliar de Droguería").toString().trim();
                const educacion = (data.get("NivelEducativo") || "No especificado").toString().trim();
                const expAnos = (data.get("ExperienciaAnos") || "No especificada").toString().trim();
                const disponibilidad = (data.get("Disponibilidad") || "Tiempo completo").toString().trim();
                const expDetalle = (data.get("ExperienciaDetalle") || "").toString().trim();

                lineas = [
                    "👋 *HOLA, DESEO POSTULARME A DROGUERÍA*",
                    "━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
                    `💼 *Cargo de interés:* ${cargo}`,
                    `⏱️ *Disponibilidad:* ${disponibilidad}`,
                    "",
                    "👤 *DATOS PERSONALES*",
                    `• *Nombre completo:* ${nombre} ${apellido}`,
                    `• *Documento:* ${tipoDoc} ${numDoc}`,
                    `• *Teléfono / WhatsApp:* ${tel}`,
                    `• *Correo electrónico:* ${correo}`,
                    `• *Ubicación:* ${ciudad} - ${barrio}`,
                    "",
                    "🎓 *PERFIL Y EXPERIENCIA*",
                    `• *Nivel educativo:* ${educacion}`,
                    `• *Años de experiencia:* ${expAnos}`,
                    expDetalle ? `• *Resumen de experiencia:* ${expDetalle}` : null,
                    "",
                    "📄 *HOJA DE VIDA*",
                    tieneArchivo ? `• *Archivo adjunto preparado:* ${nombreArchivo}` : null,
                    enlaceCv ? `• *Enlace CV / Perfil:* ${enlaceCv}` : null,
                    !tieneArchivo && !enlaceCv ? "• *Hoja de vida:* La compartiré por este chat" : null,
                    "",
                    "✅ *Autorización de datos:* Autorizo el tratamiento de mis datos personales para este proceso de selección."
                ].filter(l => l !== null);
            } else {
                const vehiculo = (data.get("Vehiculo") || "No especificado").toString().trim();
                const licencia = (data.get("Licencia") || "No especificada").toString().trim();
                const papeles = (data.get("PapelesAlDia") || "Al día").toString().trim();
                const zonas = (data.get("ZonasTrabajo") || "No especificadas").toString().trim();
                const disponibilidad = (data.get("Disponibilidad") || "Tiempo completo").toString().trim();
                const expDetalle = (data.get("ExperienciaDetalle") || "").toString().trim();

                lineas = [
                    "👋 *HOLA, DESEO POSTULARME COMO REPARTIDOR*",
                    "━━━━━━━━━━━━━━━━━━━━━━━━━━━━",
                    `🛵 *Vehículo disponible:* ${vehiculo}`,
                    `⏱️ *Disponibilidad:* ${disponibilidad}`,
                    "",
                    "👤 *DATOS PERSONALES*",
                    `• *Nombre completo:* ${nombre} ${apellido}`,
                    `• *Documento:* ${tipoDoc} ${numDoc}`,
                    `• *Teléfono / WhatsApp:* ${tel}`,
                    `• *Correo electrónico:* ${correo}`,
                    `• *Ubicación:* ${ciudad} - ${barrio}`,
                    "",
                    "🚦 *MOVILIDAD Y COBERTURA*",
                    `• *Licencia de conducción:* ${licencia}`,
                    `• *Documentos del vehículo:* ${papeles}`,
                    `• *Zonas de preferencia:* ${zonas}`,
                    expDetalle ? `• *Experiencia en reparto:* ${expDetalle}` : null,
                    "",
                    "📄 *DOCUMENTOS*",
                    tieneArchivo ? `• *Documento preparado:* ${nombreArchivo}` : null,
                    enlaceCv ? `• *Enlace a documentos:* ${enlaceCv}` : null,
                    !tieneArchivo && !enlaceCv ? "• *Documentación:* La compartiré por este chat" : null,
                    "",
                    "✅ *Autorización de datos:* Autorizo la verificación de antecedentes y datos para el ingreso a la flota."
                ].filter(l => l !== null);
            }

            return {
                textoPlano: lineas.join("\n"),
                nombreCompleto: `${nombre} ${apellido}`.trim()
            };
        }

        function enviarPostulacion(evento, rol) {
            evento.preventDefault();
            const form = rol === "empleado" ? document.getElementById("formEmpleado") : document.getElementById("formRepartidor");

            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const { textoPlano, nombreCompleto } = construirMensajeWhatsApp(rol);
            const urlWhatsApp = `https://wa.me/${NUMERO_WHATSAPP}?text=${encodeURIComponent(textoPlano)}`;

            // Actualizar modal
            const nombreEl = document.getElementById("modalNombreCandidato");
            const btnReabrir = document.getElementById("modalBtnReabrirWa");
            if (nombreEl) nombreEl.textContent = nombreCompleto || "Candidato";
            if (btnReabrir) btnReabrir.href = urlWhatsApp;

            // Abrir WhatsApp: en móviles usa redirección directa a la app nativa; en PC abre nueva pestaña
            const esMovil = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
            if (esMovil) {
                window.location.href = urlWhatsApp;
            } else {
                window.open(urlWhatsApp, "_blank");
            }

            // Mostrar modal de confirmación
            const modalEl = document.getElementById("modalConfirmacionPostulacion");
            if (modalEl && typeof bootstrap !== "undefined") {
                const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
                modal.show();
            }
        }

        async function copiarResumenPostulacion(rol) {
            const form = rol === "empleado" ? document.getElementById("formEmpleado") : document.getElementById("formRepartidor");
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const { textoPlano } = construirMensajeWhatsApp(rol);
            let copiado = false;
            try {
                if (navigator.clipboard && window.isSecureContext) {
                    await navigator.clipboard.writeText(textoPlano);
                    copiado = true;
                } else {
                    const tempTa = document.createElement("textarea");
                    tempTa.value = textoPlano;
                    tempTa.style.position = "fixed";
                    tempTa.style.left = "-9999px";
                    document.body.appendChild(tempTa);
                    tempTa.focus();
                    tempTa.select();
                    copiado = document.execCommand('copy');
                    document.body.removeChild(tempTa);
                }
            } catch (err) {
                copiado = false;
            }

            if (copiado) {
                const toastEl = document.getElementById("toastCopiado");
                if (toastEl && typeof bootstrap !== "undefined") {
                    const toast = bootstrap.Toast.getOrCreateInstance(toastEl);
                    toast.show();
                } else {
                    alert("¡Resumen de postulación copiado con éxito!");
                }
            } else {
                alert("Puedes enviar directamente tu postulación pulsando en 'Enviar Postulación por WhatsApp'.");
            }
        }

        function toggleFaq(btn) {
            const item = btn.closest(".faq-accordion-item");
            if (item) {
                const isOpen = item.classList.contains("open");
                document.querySelectorAll(".faq-accordion-item").forEach(el => el.classList.remove("open"));
                if (!isOpen) {
                    item.classList.add("open");
                }
            }
        }
    </script>
}
