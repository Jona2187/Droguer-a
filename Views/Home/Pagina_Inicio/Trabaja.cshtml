@{
    ViewData["Title"] = "Crezcamos Juntos | Trabaja con Nosotros";
    ViewData["ActiveNav"] = "trabaja";
    Layout = (User.Identity?.IsAuthenticated == true && User.IsInRole("Cliente"))
        ? "/Views/Shared/_LayoutCliente.cshtml"
        : "/Views/Shared/_LayoutPublico.cshtml";
}

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/trabaja.css" asp-append-version="true" />

<div class="pagina-trabaja">
    <div class="trabaja-main-wrapper">

        <!-- Barra de Navegación y Estado -->
        <div class="trabaja-nav-bar">
            @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Cliente"))
            {
                <a asp-controller="Tienda" asp-action="Catalogo" class="btn-volver-portal">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver a la Tienda</span>
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" class="btn-volver-portal">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver al Inicio</span>
                </a>
            }

            <div class="trabaja-live-badge">
                <span class="trabaja-pulse-dot"></span>
                <span>Convocatoria de Talento Abierta</span>
            </div>
        </div>

        <!-- HERO SECTION -->
        <header class="trabaja-hero-card">
            <div class="trabaja-hero-pill">
                <i class="bi bi-stars"></i>
                <span>Crezcamos Juntos</span>
            </div>
            <h1 class="trabaja-hero-title">
                Impulsa tu carrera y <span class="text-gradient">Crezcamos Juntos</span>
            </h1>
            <p class="trabaja-hero-sub">
                En Droguería creemos que las personas son el alma de nuestro servicio. Buscamos talento con vocación humana,
                comprometido con la salud y el bienestar. Únete a una red en constante expansión donde podrás desarrollar todo tu potencial.
            </p>

            <div class="trabaja-hero-chips">
                <div class="hero-chip">
                    <i class="bi bi-shield-check"></i>
                    <span>Contrato formal y prestaciones</span>
                </div>
                <div class="hero-chip">
                    <i class="bi bi-graph-up-arrow"></i>
                    <span>Plan de carrera y ascensos</span>
                </div>
                <div class="hero-chip">
                    <i class="bi bi-clock-history"></i>
                    <span>Turnos organizados y descanso</span>
                </div>
                <div class="hero-chip">
                    <i class="bi bi-geo-alt-fill"></i>
                    <span>Cercanía a tu lugar de vivienda</span>
                </div>
            </div>
        </header>

        <!-- PILARES / BENEFICIOS -->
        <section class="trabaja-pilares-grid" aria-label="Beneficios de trabajar con nosotros">
            <article class="pilar-card">
                <div class="pilar-icon-box">
                    <i class="bi bi-heart-pulse-fill"></i>
                </div>
                <h3>Bienestar Integral</h3>
                <p>Priorizamos la salud física y mental de nuestro equipo con espacios de integración y beneficios de salud.</p>
            </article>

            <article class="pilar-card">
                <div class="pilar-icon-box">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <h3>Formación Continua</h3>
                <p>Capacitación permanente en farmacología, atención al cliente y herramientas de gestión digital.</p>
            </article>

            <article class="pilar-card">
                <div class="pilar-icon-box">
                    <i class="bi bi-trophy-fill"></i>
                </div>
                <h3>Reconocimiento al Mérito</h3>
                <p>Incentivos por desempeño, puntualidad y excelencia en el servicio a la comunidad.</p>
            </article>

            <article class="pilar-card">
                <div class="pilar-icon-box">
                    <i class="bi bi-people-fill"></i>
                </div>
                <h3>Gran Clima Laboral</h3>
                <p>Cultura de respeto, comunicación transparente y trabajo en equipo solidario en cada una de nuestras sedes.</p>
            </article>
        </section>

        <!-- SELECTOR DE ROL / CARGO -->
        <section class="trabaja-selector-seccion" id="postulacion">
            <div class="selector-header">
                <h2>¿En qué área deseas destacar?</h2>
                <p>Selecciona tu perfil de interés para personalizar el formulario de postulación</p>
            </div>

            <div class="roles-grid" role="tablist">
                <!-- Tarjeta Empleado -->
                <button type="button" class="role-tab-btn activo" id="tabRolEmpleado" onclick="cambiarRol('empleado')" role="tab" aria-selected="true" aria-controls="formSeccionEmpleado">
                    <div class="role-tab-icon">
                        <i class="bi bi-hospital"></i>
                    </div>
                    <div class="role-tab-info">
                        <span class="role-tab-badge">Puntos de Venta & Farmacia</span>
                        <h3 class="role-tab-title">Personal de Droguería</h3>
                        <p class="role-tab-desc">Atención farmacéutica, auxiliares, regentes, cajeros, ventas y gestión de bodega.</p>
                    </div>
                    <div class="role-tab-check">
                        <i class="bi bi-check-lg"></i>
                    </div>
                </button>

                <!-- Tarjeta Repartidor -->
                <button type="button" class="role-tab-btn" id="tabRolRepartidor" onclick="cambiarRol('repartidor')" role="tab" aria-selected="false" aria-controls="formSeccionRepartidor">
                    <div class="role-tab-icon">
                        <i class="bi bi-bicycle"></i>
                    </div>
                    <div class="role-tab-info">
                        <span class="role-tab-badge badge-destacado">Ingreso Inmediato</span>
                        <h3 class="role-tab-title">Equipo de Reparto</h3>
                        <p class="role-tab-desc">Domiciliarios motorizados o en bicicleta, rutas ágiles, horarios flexibles e ingresos atractivos.</p>
                    </div>
                    <div class="role-tab-check">
                        <i class="bi bi-check-lg"></i>
                    </div>
                </button>
            </div>
        </section>

        <!-- FORMULARIO PROFESIONAL -->
        <main class="trabaja-form-card" id="formCard">

            <!-- ==========================================
                 FORMULARIO 1: PERSONAL DE DROGUERÍA
            =========================================== -->
            <form id="formEmpleado" class="formulario-rol" onsubmit="enviarPostulacion(event, 'empleado')" novalidate>
                <div class="form-header-bar">
                    <div class="form-title-group">
                        <h2>Postulación: Personal de Droguería</h2>
                        <p>Diligencia tus datos para que nuestro equipo de Gestión Humana evalúe tu perfil.</p>
                    </div>
                    <div class="form-meta-badges">
                        <span class="form-meta-tag"><i class="bi bi-clock"></i> ~2 min</span>
                        <span class="form-meta-tag"><i class="bi bi-lock-fill"></i> Datos protegidos</span>
                    </div>
                </div>

                <!-- Paso 1: Datos Personales -->
                <div class="form-step-section">
                    <div class="form-step-title">
                        <span class="step-num">1</span>
                        <span>Información Personal y Contacto</span>
                    </div>

                    <div class="form-grid-2">
                        <div>
                            <label class="campo-label" for="empNombre">Nombre(s) <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-person input-icon"></i>
                                <input type="text" class="form-control-pro" id="empNombre" name="Nombre" placeholder="Ej. Carlos Andrés" required maxlength="60" autocomplete="given-name">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empApellido">Apellidos <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-person input-icon"></i>
                                <input type="text" class="form-control-pro" id="empApellido" name="Apellido" placeholder="Ej. Rodríguez Gómez" required maxlength="60" autocomplete="family-name">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empTipoDoc">Tipo de Documento <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-card-text input-icon"></i>
                                <select class="form-control-pro" id="empTipoDoc" name="TipoDocumento" required>
                                    <option value="C.C.">Cédula de Ciudadanía (C.C.)</option>
                                    <option value="C.E.">Cédula de Extranjería (C.E.)</option>
                                    <option value="P.P.T.">Permiso Protección Temporal (P.P.T.)</option>
                                    <option value="Pasaporte">Pasaporte</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empNumeroDoc">Número de Documento <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-hash input-icon"></i>
                                <input type="text" class="form-control-pro" id="empNumeroDoc" name="NumeroDocumento" placeholder="Ej. 1020304050" required maxlength="20">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empTelefono">Teléfono / WhatsApp <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-whatsapp input-icon"></i>
                                <input type="tel" class="form-control-pro" id="empTelefono" name="Telefono" placeholder="Ej. 300 123 4567" required maxlength="20" autocomplete="tel">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empCorreo">Correo Electrónico <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-envelope input-icon"></i>
                                <input type="email" class="form-control-pro" id="empCorreo" name="Correo" placeholder="ejemplo@correo.com" required maxlength="80" autocomplete="email">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empCiudad">Ciudad / Municipio <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-geo-alt input-icon"></i>
                                <input type="text" class="form-control-pro" id="empCiudad" name="Ciudad" placeholder="Ej. Bogotá D.C." required maxlength="60">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empBarrio">Barrio o Localidad <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-pin-map input-icon"></i>
                                <input type="text" class="form-control-pro" id="empBarrio" name="Barrio" placeholder="Ej. Chapinero / Engativá" required maxlength="60">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Paso 2: Perfil Laboral -->
                <div class="form-step-section">
                    <div class="form-step-title">
                        <span class="step-num">2</span>
                        <span>Perfil Profesional y Cargo de Interés</span>
                    </div>

                    <div class="form-grid-2">
                        <div>
                            <label class="campo-label" for="empCargo">Cargo al que aspira <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-briefcase input-icon"></i>
                                <select class="form-control-pro" id="empCargo" name="Cargo" required>
                                    <option value="" selected disabled>Selecciona el cargo deseado</option>
                                    <option value="Auxiliar de Droguería y Farmacia">Auxiliar de Droguería y Farmacia</option>
                                    <option value="Regente de Farmacia">Regente de Farmacia</option>
                                    <option value="Asesor(a) Comercial y Mostrador">Asesor(a) Comercial y Mostrador</option>
                                    <option value="Cajero(a) de Punto de Venta">Cajero(a) de Punto de Venta</option>
                                    <option value="Auxiliar de Bodega e Inventario">Auxiliar de Bodega e Inventario</option>
                                    <option value="Aprendiz SENA / Prácticas">Aprendiz SENA / Etapa Práctica</option>
                                    <option value="Otro">Otro cargo afín</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empNivelEducativo">Nivel Educativo <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-mortarboard input-icon"></i>
                                <select class="form-control-pro" id="empNivelEducativo" name="NivelEducativo" required>
                                    <option value="" selected disabled>Selecciona tu nivel de estudios</option>
                                    <option value="Técnico en Servicios Farmacéuticos">Técnico en Servicios Farmacéuticos</option>
                                    <option value="Tecnólogo en Regencia de Farmacia">Tecnólogo en Regencia de Farmacia</option>
                                    <option value="Bachiller Académico">Bachiller Académico</option>
                                    <option value="Estudiante Universitario">Estudiante Universitario en curso</option>
                                    <option value="Profesional Químico Farmacéutico">Profesional Químico Farmacéutico</option>
                                    <option value="Otro">Otro</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empExperienciaAnos">Años de experiencia en droguería / farmacia <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-award input-icon"></i>
                                <select class="form-control-pro" id="empExperienciaAnos" name="ExperienciaAnos" required>
                                    <option value="Sin experiencia previa (Primer empleo / Prácticas)">Sin experiencia previa (Primer empleo / Prácticas)</option>
                                    <option value="Menos de 1 año">Menos de 1 año</option>
                                    <option value="1 a 3 años">1 a 3 años</option>
                                    <option value="Más de 3 años">Más de 3 años</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empDisponibilidad">Disponibilidad de Horario <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-calendar-check input-icon"></i>
                                <select class="form-control-pro" id="empDisponibilidad" name="Disponibilidad" required>
                                    <option value="Tiempo completo (Turnos rotativos)">Tiempo completo (Turnos rotativos)</option>
                                    <option value="Turno Mañana">Turno Mañana</option>
                                    <option value="Turno Tarde / Noche">Turno Tarde / Noche</option>
                                    <option value="Fines de semana y festivos">Fines de semana y festivos</option>
                                </select>
                            </div>
                        </div>

                        <div class="form-col-full">
                            <label class="campo-label" for="empExperienciaDetalle">
                                Resumen de tu experiencia laboral y fortalezas
                            </label>
                            <textarea class="form-control-pro no-icon" id="empExperienciaDetalle" name="ExperienciaDetalle" maxlength="500" placeholder="Describe brevemente tus funciones anteriores, droguerías donde has laborado, manejo de caja, dispensación de fórmulas o habilidades que aportarás a nuestro equipo..." oninput="actualizarContador(this, 'contadorEmp')"></textarea>
                            <div class="char-counter" id="contadorEmp">0 / 500 caracteres</div>
                        </div>
                    </div>
                </div>

                <!-- Paso 3: Hoja de Vida y Enlaces -->
                <div class="form-step-section">
                    <div class="form-step-title">
                        <span class="step-num">3</span>
                        <span>Hoja de Vida o Enlace Profesional (Opcional)</span>
                    </div>

                    <div class="form-grid-2">
                        <div>
                            <label class="campo-label">Adjuntar Hoja de Vida (PDF, DOCX)</label>
                            <div class="cv-upload-dropzone" onclick="document.getElementById('empArchivoCv').click()" id="dropzoneEmp">
                                <input type="file" id="empArchivoCv" accept=".pdf,.doc,.docx" style="display: none;" onchange="procesarArchivo(this, 'previewEmp', 'nombreArchivoEmp')">
                                <div class="cv-icon-circle">
                                    <i class="bi bi-cloud-arrow-up-fill"></i>
                                </div>
                                <div class="cv-title">Haz clic o arrastra tu archivo aquí</div>
                                <p class="cv-sub">Formatos permitidos: PDF o Word (Máximo 5MB)</p>
                            </div>
                            <div class="cv-file-preview" id="previewEmp">
                                <div class="cv-file-info">
                                    <i class="bi bi-file-earmark-pdf-fill text-danger fs-5"></i>
                                    <span id="nombreArchivoEmp">archivo.pdf</span>
                                </div>
                                <button type="button" class="cv-remove-btn" onclick="quitarArchivo('empArchivoCv', 'previewEmp')" title="Quitar archivo">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="empEnlaceCv">O pega el enlace de tu CV / LinkedIn / Drive</label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-link-45deg input-icon"></i>
                                <input type="url" class="form-control-pro" id="empEnlaceCv" name="EnlaceCv" placeholder="https://linkedin.com/in/... o enlace de Drive">
                            </div>
                            <p class="small text-muted mt-2">Asegúrate de que el enlace de Drive tenga permisos de lectura abiertos.</p>
                        </div>
                    </div>
                </div>

                <!-- Consentimiento -->
                <div class="consentimiento-box">
                    <input type="checkbox" id="empConsentimiento" required>
                    <label for="empConsentimiento">
                        Autorizo de manera libre, previa y voluntaria a Droguería el tratamiento de mis datos personales para fines exclusivos del proceso de selección y contacto laboral, de acuerdo con la Ley 1581 de 2012 y las <a href="#contacto">políticas de privacidad</a>.
                    </label>
                </div>

                <!-- Botones de Acción -->
                <div class="form-actions-wrapper">
                    <button type="submit" class="btn-postulacion-whatsapp" id="btnSubmitEmp">
                        <i class="bi bi-whatsapp"></i>
                        <span>Enviar Postulación por WhatsApp</span>
                    </button>
                    <button type="button" class="btn-postulacion-secondary" onclick="copiarResumenPostulacion('empleado')">
                        <i class="bi bi-clipboard-check"></i>
                        <span>Copiar resumen de mi postulación</span>
                    </button>
                    <div class="form-disclaimer">
                        <i class="bi bi-info-circle"></i>
                        <span>Al enviar, se abrirá WhatsApp con todos tus datos organizados para una revisión inmediata por Gestión Humana.</span>
                    </div>
                </div>
            </form>

            <!-- ==========================================
                 FORMULARIO 2: REPARTIDOR / DOMICILIOS
            =========================================== -->
            <form id="formRepartidor" class="formulario-rol" style="display: none;" onsubmit="enviarPostulacion(event, 'repartidor')" novalidate>
                <div class="form-header-bar">
                    <div class="form-title-group">
                        <h2>Postulación: Repartidor y Domicilios</h2>
                        <p>Únete a nuestra flota de entregas rápidas con las mejores comisiones y apoyo en ruta.</p>
                    </div>
                    <div class="form-meta-badges">
                        <span class="form-meta-tag"><i class="bi bi-lightning-charge-fill text-warning"></i> Ingreso Rápido</span>
                        <span class="form-meta-tag"><i class="bi bi-lock-fill"></i> Datos protegidos</span>
                    </div>
                </div>

                <!-- Paso 1: Datos Personales -->
                <div class="form-step-section">
                    <div class="form-step-title">
                        <span class="step-num">1</span>
                        <span>Información Personal y Contacto</span>
                    </div>

                    <div class="form-grid-2">
                        <div>
                            <label class="campo-label" for="repNombre">Nombre(s) <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-person input-icon"></i>
                                <input type="text" class="form-control-pro" id="repNombre" name="Nombre" placeholder="Ej. Javier" required maxlength="60" autocomplete="given-name">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="repApellido">Apellidos <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-person input-icon"></i>
                                <input type="text" class="form-control-pro" id="repApellido" name="Apellido" placeholder="Ej. Mendoza Torres" required maxlength="60" autocomplete="family-name">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="repTipoDoc">Tipo de Documento <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-card-text input-icon"></i>
                                <select class="form-control-pro" id="repTipoDoc" name="TipoDocumento" required>
                                    <option value="C.C.">Cédula de Ciudadanía (C.C.)</option>
                                    <option value="C.E.">Cédula de Extranjería (C.E.)</option>
                                    <option value="P.P.T.">Permiso Protección Temporal (P.P.T.)</option>
                                    <option value="Pasaporte">Pasaporte</option>
                                </select>
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="repNumeroDoc">Número de Documento <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-hash input-icon"></i>
                                <input type="text" class="form-control-pro" id="repNumeroDoc" name="NumeroDocumento" placeholder="Ej. 1012345678" required maxlength="20">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="repTelefono">Teléfono / WhatsApp <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-whatsapp input-icon"></i>
                                <input type="tel" class="form-control-pro" id="repTelefono" name="Telefono" placeholder="Ej. 312 987 6543" required maxlength="20" autocomplete="tel">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="repCorreo">Correo Electrónico <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-envelope input-icon"></i>
                                <input type="email" class="form-control-pro" id="repCorreo" name="Correo" placeholder="repartidor@correo.com" required maxlength="80" autocomplete="email">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="repCiudad">Ciudad / Municipio <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-geo-alt input-icon"></i>
                                <input type="text" class="form-control-pro" id="repCiudad" name="Ciudad" placeholder="Ej. Bogotá D.C." required maxlength="60">
                            </div>
                        </div>

                        <div>
                            <label class="campo-label" for="repBarrio">Barrio o Localidad donde resides <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-pin-map input-icon"></i>
                                <input type="text" class="form-control-pro" id="repBarrio" name="Barrio" placeholder="Ej. Suba / Kennedy" required maxlength="60">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Paso 2: Movilidad y Vehículo -->
                <div class="form-step-section">
                    <div class="form-step-title">
                        <span class="step-num">2</span>
                        <span>Vehículo, Documentación y Disponibilidad</span>
                    </div>

                    <div class="form-grid-2">
                        <div>
                            <label class="campo-label" for="repVehiculo">Tipo de Vehículo disponible <span class="req">*</span></label>
                            <div class="input-icon-wrapper">
                                <i class="bi bi-bicycle input-icon"></i>
                                <select class="form-control-pro" id="repVehiculo" name="Vehiculo" required onchange="cambiarTipoVehiculo(this.value)">
                                    <option value="" selected disabled>Selecciona el vehículo</option>
                                    <option value="Motocicleta Propia">Motocicleta Propia</option>
                                    <option value="Bicicleta Convencional">Bicicleta Convencional</option>
                                    <option value="Bicicleta Eléctrica">Bicicleta Eléctrica</option>
                                    <option value="Automóvil / Furgón Pequeño">Automóvil / Furgón Pequeño</option>
                                </select>
                            </div>
                        </div>

