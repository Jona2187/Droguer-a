                        <div class="text-end">
                            <small class="text-muted d-block">TOTAL CANCELADO:</small>
                            <span class="fs-4 fw-black text-primary" style="font-weight: 900;">$${totalMonto.toLocaleString('es-CO', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} COP</span>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="button" class="btn btn-outline-secondary flex-grow-1 py-2.5 rounded-pill" onclick="imprimirComprobanteDigitalDrogueria()">
                        🖨️ Imprimir / Guardar PDF
                    </button>
                    <button type="button" class="btn btn-primary flex-grow-1 py-2.5 rounded-pill fw-bold shadow-sm" onclick="confirmarYEnviarPedido()">
                        ✅ Finalizar y Guardar Pedido
                    </button>
                </div>
            `;
        }
    }

    function imprimirComprobanteDigitalDrogueria() {
        window.print();
    }

    function confirmarYEnviarPedido() {
        const form = document.getElementById('formPedido');
        if (form) form.submit();
    }
</script>
}
