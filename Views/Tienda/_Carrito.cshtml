@model List<Drogueria.Models.CarritoItem>
<style>
/* Permitir que el modal no corte el dropdown */
#modalDireccion .modal-body { overflow: visible !important; }
#modalDireccion .modal-content { overflow: visible !important; }
#modalDireccion .modal-dialog { overflow: visible !important; }

.custom-select-wrap { position: relative; }
.custom-dropdown {
    position: absolute; bottom: 100%; top: auto; left: 0; right: 0;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 10px 10px 0 0;
    max-height: 210px; overflow-y: auto; z-index: 9999;
    display: none; box-shadow: 0 -8px 24px rgba(0,0,0,.18);
    scrollbar-width: thin; scrollbar-color: var(--border) transparent;
}
.custom-dropdown.visible { display: block; }
.custom-dropdown-item {
    padding: 9px 14px; font-size: 13px; cursor: pointer;
    color: var(--t-base); transition: background .12s;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.custom-dropdown-item:hover,
.custom-dropdown-item.active { background: var(--primary-soft); color: var(--primary); }
.custom-dropdown-empty { padding: 10px 14px; font-size: 13px; color: var(--t-muted); font-style: italic; }
</style>

@{
    Layout = "~/Views/Shared/_LayoutCliente.cshtml";
    ViewData["Title"] = "Mi Carrito";
    ViewData["ActiveNav"] = "carrito";
    var total = Model.Sum(i => i.Subtotal);
    var dirsList = ViewBag.Direcciones as List<Drogueria.Models.DireccionUsuario> ?? new List<Drogueria.Models.DireccionUsuario>();
    var dirPredeterminada = dirsList.FirstOrDefault(d => d.EsPredeterminada);
}

<!-- Leaflet CSS -->
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<style>
    .direccion-card {
        border: 2px solid var(--border, #dee2e6);
        border-radius: 12px;
        padding: 14px;
        cursor: pointer;
        background: var(--bg-card, #fff);
        transition: all 0.2s ease;
        height: 100%;
    }
    .direccion-card:hover { border-color: var(--primary, #0d6efd); }
    .direccion-card.selected {
        border-color: var(--primary, #0d6efd);
        background: var(--primary-soft, #e8f0fe);
    }
    #listaDirecciones .col-md-6,
    #listaDirecciones .col-lg-4 {
        display: flex;
    }
    #listaDirecciones .col-md-6 > div,
    #listaDirecciones .col-lg-4 > div {
        width: 100%;
    }
</style>

<div class="container-fluid px-3 px-lg-5">

    <!-- Encabezado de Página -->
    <div class="tienda-page-header">
        <div>
            <h1>
                <i class="bi bi-cart3 text-primary"></i>
                <span>Mi Carrito de Compras</span>
            </h1>
            <p class="text-muted small mb-0">Revisa los medicamentos seleccionados antes de completar tu pedido</p>
        </div>

        <a asp-controller="Tienda" asp-action="Catalogo" class="tienda-back-btn">
            <i class="bi bi-arrow-left"></i>
            <span>Continuar Comprando</span>
        </a>
    </div>

    <!-- Alertas Flash -->
    @if (TempData["Exito"] != null || TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3" role="alert">
            <i class="bi bi-check-circle-fill fs-5"></i>
            <div>@(TempData["Exito"] ?? TempData["Success"])</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2 shadow-sm rounded-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div>@TempData["Error"]</div>
            <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="tienda-empty">
            <i class="bi bi-cart-x"></i>
            <h3>Tu carrito está vacío</h3>
            <p>Aún no has agregado ningún producto. Explora nuestro catálogo y añade lo que necesites.</p>
            <a asp-controller="Tienda" asp-action="Catalogo" class="tienda-empty-btn">
                <i class="bi bi-arrow-left"></i>
                <span>Ir al Catálogo</span>
            </a>
        </div>
    }
    else
    {
        <!-- ═══════════════════════════════════════════════════════
             SECCIÓN DIRECCIÓN DE ENTREGA (ancho completo, encima)
        ═══════════════════════════════════════════════════════ -->
        <div class="mb-4">
            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="mb-0 fw-bold">
                    <i class="bi bi-geo-alt-fill text-danger me-2"></i>Dirección de Entrega
                </h5>
                <button type="button" class="btn btn-outline-primary btn-sm rounded-pill"
                        onclick="abrirModalDireccion()">
                    <i class="bi bi-plus-lg me-1"></i> Nueva Dirección
                </button>
            </div>

            <!-- Tarjetas de direcciones guardadas -->
            <div id="listaDirecciones" class="row g-2 mb-2">
                @if (dirsList.Any())
                {
                    foreach (var dir in dirsList)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="direccion-card @(dir.EsPredeterminada ? "selected" : "")"
                                 data-id="@dir.Id"
                                 onclick="seleccionarDireccion(this)">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="fw-bold small">@dir.NombreContacto</span>
                                    @if (dir.EsPredeterminada)
                                    {
                                        <span class="badge bg-primary-subtle text-primary" style="font-size:10px;">Predeterminada</span>
                                    }
                                </div>
                                <p class="mb-1 text-muted" style="font-size:12px;">@dir.Direccion</p>
                                <p class="mb-1 text-muted" style="font-size:12px;">@dir.Ciudad, @dir.Departamento</p>
                                <p class="mb-2 text-muted" style="font-size:12px;">
                                    <i class="bi bi-telephone me-1"></i>@dir.Telefono
                                </p>
                                <div class="d-flex gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                            title="Editar" onclick="editarDireccion(event, '@dir.Id')">
                                        <i class="bi bi-pencil" style="font-size:11px;"></i>
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-danger py-0 px-2"
                                            title="Eliminar" onclick="eliminarDireccion(event, '@dir.Id', this)">
                                        <i class="bi bi-trash3" style="font-size:11px;"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12" id="sinDirecciones">
                        <p class="text-muted small">
                            <i class="bi bi-info-circle me-1"></i>No tienes direcciones guardadas. Agrega una para continuar.
                        </p>
                    </div>
                }
            </div>

            <input type="hidden" id="direccionSeleccionadaId"
                   value="@(dirPredeterminada?.Id.ToString() ?? "")" />
            <div id="errorDireccion" class="text-danger small mt-1" style="display:none;">
                <i class="bi bi-exclamation-circle me-1"></i>Selecciona una dirección de entrega.
            </div>
        </div>

        <div class="row g-4">
            <!-- Tabla de Productos -->
            <div class="col-lg-8">
                <div class="carrito-wrap">
                    <div class="table-responsive">
                        <table class="carrito-table">
                            <thead>
                                <tr>
                                    <th>Producto</th>
                                    <th>Precio</th>
                                    <th style="width: 140px; text-align: center;">Cantidad</th>
                                    <th style="text-align: right;">Subtotal</th>
                                    <th style="width: 50px;"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    var imgUrl = !string.IsNullOrEmpty(item.Imagen)
                                        ? (item.Imagen.StartsWith("http") ? item.Imagen : (item.Imagen.StartsWith("/") ? item.Imagen : "/" + item.Imagen))
                                        : "";

                                    <tr data-producto-id="@item.ProductoId" data-stock="@item.StockDisponible">
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                @if (!string.IsNullOrEmpty(imgUrl))
                                                {
                                                    <img src="@imgUrl" alt="@item.Nombre" class="carrito-item-img"
                                                         onerror="this.style.display='none'; this.nextElementSibling.classList.remove('d-none'); this.nextElementSibling.classList.add('d-flex');" />
                                                    <div class="carrito-item-img align-items-center justify-content-center text-muted d-none"
                                                         style="background: var(--bg-muted);">
                                                        <i class="bi bi-capsule"></i>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="carrito-item-img d-flex align-items-center justify-content-center text-muted"
                                                         style="background: var(--bg-muted);">
                                                        <i class="bi bi-capsule"></i>
                                                    </div>
                                                }
                                                <div>
                                                    <span class="carrito-item-name">@item.Nombre</span>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-nowrap">
                                            $@item.Precio.ToString("N2")
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center justify-content-center gap-1">
                                                <input type="hidden" class="item-producto-id" value="@item.ProductoId" />
                                                <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1 btn-decrementar"
                                                        data-producto-id="@item.ProductoId"
                                                        onclick="ajustarCantidad('@item.ProductoId', -1, this)"
                                                        @(item.Cantidad <= 1 ? "disabled" : "")>-</button>
                                                <input type="number" value="@item.Cantidad" min="1" max="@item.StockDisponible"
                                                       class="carrito-qty-input item-cantidad-input"
                                                       data-producto-id="@item.ProductoId"
                                                       data-stock="@item.StockDisponible"
                                                       onchange="cambiarCantidadManual(this)" />
                                                <button type="button" class="btn btn-outline-secondary btn-sm px-2 py-1 btn-incrementar"
                                                        data-producto-id="@item.ProductoId"
                                                        onclick="ajustarCantidad('@item.ProductoId', 1, this)"
                                                        @(item.Cantidad >= item.StockDisponible ? "disabled" : "")>+</button>
                                            </div>
                                        </td>
                                        <td style="text-align: right;" class="carrito-subtotal text-nowrap"
                                            data-producto-id="@item.ProductoId">
                                            $@item.Subtotal.ToString("N2")
                                        </td>
                                        <td style="text-align: center;">
                                            <button type="button" class="btn btn-link text-danger p-0"
                                                    title="Eliminar del carrito"
                                                    onclick="eliminarDelCarrito('@item.ProductoId', this)">
                                                <i class="bi bi-trash3 fs-5"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center p-3 border-top"
                         style="background: var(--bg-muted);">
                        <button type="button"
                                class="btn btn-outline-danger btn-sm rounded-pill d-flex align-items-center gap-1 px-3"
                                onclick="vaciarCarrito(this)">
                            <i class="bi bi-trash"></i> Vaciar Carrito
                        </button>
                        <span class="text-muted small" id="totalItemsCarrito">
                            @Model.Sum(i => i.Cantidad) artículo(s) en total
                        </span>
                    </div>
                </div>
            </div>

            <!-- Resumen de Compra -->
            <div class="col-lg-4">
                <div class="pedido-card">
                    <div class="pedido-card-header">
                        <span class="fw-bold fs-6">Resumen del Pedido</span>
                        <i class="bi bi-receipt text-primary"></i>
                    </div>
                    <div class="pedido-card-body">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Subtotal</span>
                            <span class="fw-semibold" id="resumenSubtotal">$@total.ToString("N2")</span>
                        </div>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted">Envío</span>
                            <span class="text-success fw-semibold">Gratis</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Impuestos incluidos</span>
                            <span class="text-muted">$0.00</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <span class="fw-bold fs-5">Total a Pagar</span>
                            <span class="carrito-total-amount" id="totalAPagar">$@total.ToString("N2")</span>
                        </div>

                        <form asp-controller="Tienda" asp-action="RealizarPedido" method="post"
                              id="formPedido" onsubmit="return false;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="direccionEntrega" id="hdnDireccionEntrega" />
                            <input type="hidden" name="metodoPago" id="hdnMetodoPago" value="Tarjeta" />
                            <input type="hidden" name="referenciaPago" id="hdnReferenciaPago" value="" />
                            <button type="button" onclick="iniciarPasarelaPago()"
                                    class="btn btn-primary w-100 py-3 rounded-pill fw-bold shadow-sm d-flex align-items-center justify-content-center gap-2">
                                <i class="bi bi-credit-card-2-front-fill fs-5"></i>
                                <span>Proceder al Pago Seguro</span>
                            </button>
                        </form>

                        <div class="text-center mt-3">
                            <small class="text-muted d-flex align-items-center justify-content-center gap-1">
                                <i class="bi bi-shield-lock-fill text-success"></i> Pago seguro y garantizado
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

<!-- ═══════════════════════════════════════════════════════
     MODAL CREAR / EDITAR DIRECCIÓN
═══════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalDireccion" tabindex="-1" aria-labelledby="modalDireccionLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-glass">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDireccionLabel">
                    <i class="bi bi-geo-alt-fill text-danger me-2"></i>Nueva Dirección
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="mdDirId" />
                <div class="row g-3">
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold small">Nombre de contacto <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="mdNombre" maxlength="50"
                               placeholder="Ej. Juan Pérez" required />
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold small">Teléfono <span class="text-danger">*</span></label>
                        <input type="tel" class="form-control" id="mdTelefono" maxlength="10"
                               placeholder="Ej. 3001234567" required oninput="this.value=this.value.replace(/[^0-9]/g,'')" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold small">Dirección <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <input type="text" class="form-control" id="mdDireccion" maxlength="150"
                                   placeholder="Ej. Cra 15 #45-23" required />
                            <button type="button" class="btn btn-outline-primary" onclick="validarDireccionMapa()"
                                    id="btnValidarMapa" title="Buscar en el mapa">
                                <i class="bi bi-search me-1"></i>Validar
                            </button>
                        </div>
                        <div id="mapValidacionMsg" class="form-text"></div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold small">Departamento <span class="text-danger">*</span></label>
                        <div class="custom-select-wrap" id="wrapDepartamento">
                            <input type="text" class="form-control" id="mdDepartamento" maxlength="50"
                                   placeholder="Buscar departamento..." autocomplete="off" required
                                   oninput="filtrarOpciones('mdDepartamento', 'dropDepartamento')"
                                   onfocus="mostrarDropdown('dropDepartamento')"
                                   onblur="ocultarDropdown('dropDepartamento')" />
                            <div class="custom-dropdown" id="dropDepartamento"></div>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <label class="form-label fw-semibold small">Ciudad <span class="text-danger">*</span></label>
                        <div class="custom-select-wrap" id="wrapCiudad">
                            <input type="text" class="form-control" id="mdCiudad" maxlength="50"
                                   placeholder="Selecciona primero el departamento..." autocomplete="off" required
                                   disabled
                                   oninput="filtrarOpciones('mdCiudad', 'dropCiudad')"
                                   onfocus="mostrarDropdown('dropCiudad')"
                                   onblur="ocultarDropdown('dropCiudad')" />
                            <div class="custom-dropdown" id="dropCiudad"></div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="mdPredeterminada" />
                            <label class="form-check-label small" for="mdPredeterminada">
                                Usar como dirección predeterminada
                            </label>
                        </div>
                    </div>
                    <!-- Mapa de validación Leaflet -->
                    <div class="col-12" id="mapaValidacionWrap" style="display:none;">
                        <div id="mapaValidacion" style="height:220px; border-radius:12px; border:1px solid var(--border, #dee2e6);"></div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary rounded-pill px-4"
                        onclick="guardarDireccion()" id="btnGuardarDireccion">
                    <i class="bi bi-check-lg me-1"></i>Guardar Dirección
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     MODAL PASARELA DE PAGO SEGURO
═══════════════════════════════════════════════════════ -->
<div class="modal fade" id="modalPasarelaPago" tabindex="-1" aria-labelledby="modalPasarelaPagoLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content modal-glass border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <div>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2 fw-semibold" style="font-size: 0.78rem;">
                        🔒 PAGO 100% SEGURO • CONEXIÓN CIFRADA 256-BIT
                    </span>
                    <h4 class="modal-title fw-extrabold mt-2 text-primary" id="modalPasarelaPagoLabel">
                        <i class="bi bi-credit-card-2-front-fill me-2"></i>Pasarela de Pago Seguro Droguería
                    </h4>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4" id="pasarelaModalBody">
                <!-- Se llena dinámicamente -->
            </div>
        </div>
    </div>
</div>

@Html.AntiForgeryToken()

@section Scripts {
<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script>
