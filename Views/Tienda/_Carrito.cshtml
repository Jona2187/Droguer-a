            { key: 'efectivo', btn: 'btnPagoTabEfectivo', form: 'formMetodoEfectivo' }
        ];

        metodos.forEach(m => {
            const btn = document.getElementById(m.btn);
            const form = document.getElementById(m.form);
            const activo = m.key === metodo;
            if (btn) {
                btn.className = activo ? 'btn btn-primary pasarela-tab-btn' : 'btn btn-outline-primary pasarela-tab-btn';
            }
            if (form) {
                form.classList.toggle('d-none', !activo);
