@{
    var brandInitial = "DR";
    var brandName = "Droguería";
    var activeNav = ViewData["ActiveNav"]?.ToString() ?? "dashboard";
    var userName = User.Identity?.IsAuthenticated == true ? User.Identity.Name : brandName;
    var userEmail = "[EMAIL_ADDRESS]";
    var userRole = "admin";
    var initials = !string.IsNullOrEmpty(userName) && userName.Length >= 2 
        ? userName.Substring(0, 2).ToUpper() 
        : brandInitial;
}

<aside class="d-sidebar" id="appSidebar">

  <!-- Botón sobre la línea divisoria entre sidebar y navbar -->
  <button class="sidebar-edge-toggle" id="sidebarToggle" type="button" aria-label="Alternar barra lateral" title="Colapsar / Expandir menú">
    <i class="bi bi-chevron-left" id="sidebarToggleIcon"></i>
  </button>

  <!-- Header & Brand -->
  <div class="brand-wrapper">
    <a asp-controller="Home" asp-action="Index" class="brand" title="@brandName">
      <div class="brand-logo">
        <img src="~/img/logodrogueria.png" alt="logo" class="brand-img" onerror="this.style.display='none'; var f=this.nextElementSibling; if(f) f.style.display='flex';" />
        <div class="brand-fallback-logo">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m10.5 20.5 10-10a4.95 4.95 0 1 0-7-7l-10 10a4.95 4.95 0 1 0 7 7Z" />
            <path d="m8.5 8.5 7 7" />
          </svg>
        </div>
      </div>
      <div class="brand-text">
        <div class="brand-name">@brandName</div>
        <div class="brand-tag">Sistema Gestor De Droguería</div>
      </div>
    </a>

    
  </div>

  <!-- Scrollable Navigations -->
  <div class="sidebar-scrollable">
    @* ================= WORKSPACE ================= *@
    <nav class="nav-section">
      <div class="nav-label">Workspace</div>

      <a class="nav-link @(activeNav == "usuarios" ? "is-active" : "")" asp-controller="Home" asp-action="Productos" data-tooltip="Usuarios" title="Usuarios">
        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-user-plus">
          <path stroke="none" d="M0 0h24v24H0z" fill="none" />
          <path d="M8 7a4 4 0 1 0 8 0a4 4 0 0 0 -8 0" />
          <path d="M16 19h6" />
          <path d="M19 16v6" />
          <path d="M6 21v-2a4 4 0 0 1 4 -4h4" />
        </svg>
        <span>Productos</span>
      </a>

    @* ================= COMPONENTES ================= *@
    <nav class="nav-section">
      <div class="nav-label">Componentes</div>

      <a class="nav-link @(activeNav == "ui" ? "is-active" : "")" href="#ui-elements" data-tooltip="Elementos UI" title="Elementos UI">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
          <circle cx="12" cy="12" r="9" />
          <path d="M8 12h8M12 8v8" />
        </svg>
        <span>Elementos UI</span>
      </a>

      <div class="nav-item-group @(activeNav == "pages" ? "is-open" : "")" data-nav-group>
        <a class="nav-link" href="javascript:void(0)" data-nav-toggle data-tooltip="Páginas" title="Páginas">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6" />
          </svg>
          <span>Páginas</span>
          <svg class="chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8">
            <path d="m9 18 6-6-6-6" />
          </svg>
        </a>
        <div class="nav-submenu">
          <a href="/Account/Login" class="@(activeNav == "login" ? "is-active" : "")">Iniciar sesión</a>
          <a href="/Home/Privacy">Privacidad</a>
          <a href="/Error/404">Error 404</a>
        </div>
      </div>
    </nav>
  </div>

  @* ================= FOOTER / PROFILE ================= *@
  <div class="sidebar-footer">
    <div class="dd-wrap">
      <div class="workspace" id="profileDropdownBtn" data-dropdown tabindex="0" role="button" aria-label="Menú de cuenta" title="@userName (@userRole)">
        <div class="workspace-avatar">@initials</div>
        <div class="workspace-text">
          <div class="workspace-name">@userName</div>
          <div class="workspace-role">@userRole</div>
        </div>
        <svg class="workspace-chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
          <path d="m7 9 5-5 5 5" />
          <path d="m7 15 5 5 5-5" />
        </svg>
      </div>

      <div class="dd-menu dd-profile" id="profileDropdownMenu" role="menu">
        <div class="dd-profile-head">
          <div class="dd-profile-name">@userName</div>
          <div class="dd-profile-email">@userEmail</div>
        </div>
        <a class="dd-menu-item" href="#settings">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75">
            <circle cx="12" cy="12" r="3" />
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z" />
          </svg>
          <span>Ajustes</span>
        </a>
        <a class="dd-menu-item" href="#profile">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
          </svg>
          <span>Perfil</span>
        </a>
        <div class="dd-divider"></div>
        <form method="post" asp-controller="Account" asp-action="Logout">
          @Html.AntiForgeryToken()
          <button type="submit" class="dd-menu-item danger" style="width:100%; border:0; background:none; text-align:left;">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" />
            </svg>
            <span>Cerrar sesión</span>
          </button>
        </form>
      </div>
    </div>
  </div>
</aside>