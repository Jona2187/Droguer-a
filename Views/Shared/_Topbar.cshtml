<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Droguería</title>

    <script>
        // Carga inmediata de tema para evitar parpadeo blanco (FOUC)
        (function () {
            const savedTheme = localStorage.getItem('app_theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site / Dashboard Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Drogueria.site.css" asp-append-version="true" />
</head>
<body>
    <div class="app-layout">
        <!-- Sidebar Navigation Partial -->
        <partial name="_Sidebar" />

        <!-- Mobile Drawer Backdrop -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Main Workspace -->
        <div class="app-main">
            <!-- App Topbar -->
            <header class="app-header">
                <div class="header-left">
                    <button class="btn-icon d-lg-none" id="mobileSidebarToggle" type="button" aria-label="Abrir menú" title="Abrir menú">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="header-breadcrumb d-none d-md-flex align-items-center gap-2">
                        <a asp-controller="Home" asp-action="Index" class="text-muted small text-decoration-none d-flex align-items-center gap-1 hover-primary">
                            <i class="bi bi-house-door" style="font-size: 13px;"></i>
                            <span>Droguería</span>
                        </a>
                        <i class="bi bi-chevron-right text-muted" style="font-size: 10px; opacity: 0.6;"></i>
                        <span class="fw-semibold small px-2 py-0-5 rounded-pill" style="background: var(--primary-soft); color: var(--primary);">
                            @(ViewData["Title"] ?? "Dashboard")
                        </span>
                    </div>
                </div>

                <div class="header-right">
                    <div class="header-search d-none d-sm-flex align-items-center position-relative">
                        <i class="bi bi-search position-absolute text-muted" style="left: 12px; font-size: 13px;"></i>
                        <input type="text" placeholder="Buscar en el sistema..." class="form-control form-control-sm ps-5 pe-4" style="border-radius: 999px; background: var(--bg-muted); border: 1px solid var(--border);" />
                        <kbd class="position-absolute end-0 me-2 small text-muted px-1 rounded border d-none d-md-inline-block" style="font-size: 10px; background: var(--bg-card); font-family: 'JetBrains Mono', monospace;">Ctrl K</kbd>
                    </div>

                    <div class="header-actions d-flex align-items-center gap-2">
                        <!-- Dark / Light Theme Toggle Button -->
                        <button class="btn-icon" id="themeToggleBtn" title="Cambiar tema oscuro / claro" type="button" aria-label="Cambiar tema">
                            <i class="bi bi-moon-stars" id="themeIcon"></i>
                        </button>

                        <div class="d-none d-md-flex align-items-center gap-2 ps-2 ms-1 border-start" style="border-color: var(--border) !important;">
                            <div class="cell-user-avatar u-primary" style="width: 32px; height: 32px; font-size: 11px; border-radius: 8px;">
                                AD
                            </div>
                            <div class="d-flex flex-column" style="line-height: 1.2;">
                                <span class="fw-semibold small" style="color: var(--t-base);">Admin</span>
                                <span class="text-muted" style="font-size: 10.5px;">En línea</span>
                            </div>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Main Content Page -->
            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <!-- App Footer -->
            <footer class="app-footer">
                <div class="container-fluid d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 p-0">
                    <div>
                        &copy; @DateTime.Now.Year <span class="fw-semibold">Droguería</span>. Todos los derechos reservados.
                    </div>
                    <div class="text-muted small">
                        Sistema Gestor de Drogueria :) v1.0
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
