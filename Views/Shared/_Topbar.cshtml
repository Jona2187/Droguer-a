<!DOCTYPE html>
<html lang="es" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Droguería</title>

    <script>
        // Carga inmediata de tema para evitar parpadeo blanco (FOUC)
        (function () {
            const savedTheme = localStorage.getItem('app_theme') || 'light';
            document.documentElement.setAttribute('data-bs-theme', savedTheme);
        })();
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Site / Dashboard Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Drogueria.styles.css" asp-append-version="true" />
</head>
<body>
    <div class="app-layout">
        <!-- Sidebar Navigation Partial -->
        <partial name="_Sidebar" />

        <!-- Mobile Drawer Backdrop -->
        <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

        <!-- Main Workspace -->
        <div class="app-main">
            <!-- App Topbar -->
            <header class="app-header">
                <div class="header-left">
                    <button class="btn-icon d-lg-none" id="mobileSidebarToggle" type="button" aria-label="Abrir menú" title="Abrir menú">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <div class="header-breadcrumb d-none d-md-flex align-items-center gap-2">
                        <span class="text-muted small">Droguería</span>
                        <span class="text-muted small">/</span>
                        <span class="fw-semibold small">@(ViewData["Title"] ?? "Dashboard")</span>
                    </div>
                </div>

                <div class="header-right">
                    <div class="header-search d-none d-sm-flex">
                        <i class="bi bi-search"></i>
                        <input type="text" placeholder="Buscar..." class="form-control form-control-sm" />
                    </div>

                    <div class="header-actions">
                        <!-- Dark / Light Theme Toggle Button -->
                        <button class="btn-icon" id="themeToggleBtn" title="Cambiar tema oscuro / claro" type="button" aria-label="Cambiar tema">
                            <i class="bi bi-moon-stars" id="themeIcon"></i>
                        </button>

                        <button class="btn-icon" title="Notificaciones" type="button">
                            <i class="bi bi-bell"></i>
                            <span class="badge-dot"></span>
                        </button>
                        <button class="btn-icon" title="Mensajes" type="button">
                            <i class="bi bi-chat-dots"></i>
                        </button>
                    </div>
                </div>
            </header>

            <!-- Main Content Page -->
            <main role="main" class="app-content">
                @RenderBody()
            </main>

            <!-- App Footer -->
            <footer class="app-footer">
                <div class="container-fluid d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 p-0">
                    <div>
                        &copy; @DateTime.Now.Year <span class="fw-semibold">Droguería</span>. Todos los derechos reservados.
                    </div>
                    <div class="text-muted small">
                        Sistema Gestor de Drogueria :) v1.0
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
